# Qwen MCP Auth POC - Environment Variables

# Port to run the server on
PORT=3000

# For a production implementation with real Google OAuth:
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# JWT_SECRET=your-jwt-secret-for-token-signing

# For development, you can run without Google OAuth (uses mock identity provider)
# If GOOGLE_CLIENT_ID is not set, the server will use a built-in fake login page