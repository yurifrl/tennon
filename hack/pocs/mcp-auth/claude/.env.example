PORT=8000
# Public base URL of this server (issuer + OAuth/Google redirect target).
# For local browser login, http://localhost:8000 works as a Google redirect URI.
PUBLIC_URL=http://localhost:8000
# Google OAuth client (Web application). Authorized redirect URI must be:
#   ${PUBLIC_URL}/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signing key for our access/refresh JWTs. Set a stable value so tokens survive restarts.
JWT_SECRET=
